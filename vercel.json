{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "python3.11",
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/health",
      "dest": "/api/index.py",
      "methods": ["GET"]
    },
    {
      "src": "/api/.*",
      "dest": "/api/index.py",
      "methods": ["GET", "POST", "DELETE"]
    }
  ]
}
